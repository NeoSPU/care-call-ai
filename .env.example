# Care Call AI local/demo operator gate.
# Public demo defaults are safe placeholders. Production deployments must
# override all three values with private values that are never committed.
CARECALL_OPERATOR_USERNAME=carecall-coordinator
CARECALL_OPERATOR_PASSWORD=change-this-local-password
CARECALL_AUTH_SECRET=change-this-to-a-long-random-secret

# Frontend server-side proxy-to-backend URL.
# Public demo local default is http://127.0.0.1:8000.
# Docker compose sets this to http://backend:8000.
# Hosted demos should set this to the HTTPS backend origin.
CARECALL_API_BASE_URL=http://127.0.0.1:8000
CARECALL_BACKEND_API_TOKEN=change-this-local-backend-token

# Optional support form delivery.
# These variables belong only in the Next.js server runtime. Browser code posts
# to /api/support and never receives this endpoint or token.
CARECALL_SUPPORT_EMAIL_ENDPOINT=
CARECALL_SUPPORT_EMAIL_TOKEN=
CARECALL_SUPPORT_RATE_LIMIT_KEY_SECRET=change-this-support-rate-limit-secret

# Optional Siri Shortcut callback intake.
# This belongs only in the Next.js server runtime. Each entry maps a registered
# recipient id to a private token stored inside that recipient's Shortcut.
# Example format: rec-001=change-this-recipient-callback-token
CARECALL_SIRI_CALLBACK_TOKENS=

# Optional final live CALL-E demo controls.
# Keep live calls disabled for private development and tests unless a consented
# real-call UAT is intentionally being run through the frontend approval gate.
CARECALL_DEMO_MAX_PHONE=
CARECALL_LIVE_CALLS_ENABLED=false
CARECALL_MAX_LIVE_BATCH_SIZE=1
CARECALL_OPERATOR_REPEAT_CALL_LIMIT=2
CARECALL_RECIPIENT_OPERATOR_CALL_LIMIT_OVERRIDES=
CARECALL_MAX_AUTO_CALLBACK_CALLS_PER_DAY=3
CARECALL_CALLBACK_REPEAT_REVIEW_LIMIT=3
CARECALL_RECIPIENT_CALLBACK_CALL_LIMIT_OVERRIDES=

# Optional server-side CALL-E provider for deployed backend live calls.
# CARECALL_BACKEND_API_TOKEN is only the frontend-to-backend bearer token.
# CARECALL_CALLE_API_KEY is the official CALL-E dashboard Access Key and must
# stay only in backend runtime secrets, never in frontend env or committed files.
CARECALL_CALLE_PROVIDER=api
CARECALL_CALLE_API_BASE_URL=https://api.heycall-e.com
CARECALL_CALLE_API_KEY=
CARECALL_CALLE_REGION=GB
CARECALL_CALLE_TIMEOUT_SECONDS=45
