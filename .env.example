# Care Call AI local/demo operator gate.
# Copy this file to .env for Docker Compose. Never commit .env.
# Hosted deployments should store these as platform secrets/environment values.
CARECALL_OPERATOR_USERNAME=carecall-coordinator
CARECALL_OPERATOR_PASSWORD=carecall-demo-password
CARECALL_AUTH_SECRET=carecall-local-dev-secret

# Frontend server-side proxy-to-backend URL.
# Local non-Docker default is http://127.0.0.1:8000.
# Docker compose sets this to http://backend:8000.
# Hosted demos should set this to the HTTPS backend origin.
CARECALL_API_BASE_URL=http://127.0.0.1:8000
CARECALL_BACKEND_API_TOKEN=change-this-local-backend-token

# Live CALL-E demo controls.
# Live calls are controlled by the frontend preflight UI: exact selected
# recipient, four confirmations, and the exact authorization phrase.
# Keep the batch size at 1 for the public demo. Edit the recipient phone number
# in the app's recipient card before a real call; do not store real phones here.
CARECALL_MAX_LIVE_BATCH_SIZE=1

# Server-side CALL-E Developer API. These values are read only by the backend.
# CARECALL_BACKEND_API_TOKEN is only the frontend-to-backend bearer token.
# CARECALL_CALLE_API_KEY is the official CALL-E dashboard API key.
CARECALL_CALLE_PROVIDER=api
CARECALL_CALLE_API_KEY=
CARECALL_CALLE_API_BASE_URL=https://api.heycall-e.com
CARECALL_CALLE_REGION=GB
CARECALL_CALLE_TIMEOUT_SECONDS=45
