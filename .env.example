# Care Call AI local/demo operator gate.
# Public demo defaults are safe placeholders. Production deployments must
# override all three values with private values that are never committed.
CARECALL_OPERATOR_USERNAME=carecall-coordinator
CARECALL_OPERATOR_PASSWORD=change-this-local-password
CARECALL_AUTH_SECRET=change-this-to-a-long-random-secret

# Frontend server-side proxy-to-backend URL.
# Local non-Docker default is http://127.0.0.1:8001.
# Docker compose sets this to http://backend:8000.
# Hosted demos should set this to the HTTPS backend origin.
CARECALL_API_BASE_URL=http://127.0.0.1:8001
CARECALL_BACKEND_API_TOKEN=change-this-local-backend-token

# Optional final live CALL-E demo controls.
# Keep live calls disabled for development, tests, public demos, and practice.
# Supply a real approved phone only in the local shell for the final call.
CARECALL_DEMO_MAX_PHONE=
CARECALL_LIVE_CALLS_ENABLED=false
CARECALL_MAX_LIVE_BATCH_SIZE=1

# Optional server-side CALL-E provider for deployed backend live calls.
# CARECALL_BACKEND_API_TOKEN is only the frontend-to-backend bearer token.
# CARECALL_CALLE_AUTH_TOKEN is the CALL-E provider credential and must stay
# only in backend runtime secrets, never in frontend env or committed files.
CARECALL_CALLE_PROVIDER=cli
CARECALL_CALLE_MCP_SERVER_URL=
CARECALL_CALLE_AUTH_TOKEN=
CARECALL_CALLE_REGION=GB
CARECALL_CALLE_TIMEOUT_SECONDS=30
