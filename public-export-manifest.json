{
  "name": "care-call-ai-demo",
  "purpose": "Sanitized public hackathon edition manifest. Keep the CALL-E-only runtime path; exclude private production infrastructure, future-provider notes, and real data.",
  "required_files": [
    "docs/PUBLIC-README.md",
    "public-export/Makefile",
    ".env.example",
    "CALL-E-installation-guide.md",
    "docker-compose.dev.yml",
    "data/seed_recipients.json",
    "backend/app/server.py",
    "backend/app/calle_execution.py",
    "backend/tests/test_calle_execution.py",
    "frontend/package.json",
    "frontend/src/app/dashboard/page.tsx",
    "frontend/src/app/dashboard/operator/page.tsx",
    "frontend/src/app/dashboard/orders/print/page.tsx",
    "frontend/src/app/dashboard/urgent-callback/page.tsx",
    "contribution/awesome-phone-call-agents/APP-README.md",
    "contribution/awesome-phone-call-agents/README-entry.md",
    "contribution/awesome-phone-call-agents/PR-DESCRIPTION.md",
    "contribution/awesome-phone-call-agents/SAFETY-CHECKLIST.md",
    "docs/DEMO-SCRIPT.md",
    "docs/FINAL-DEMO-CHECKLIST.md",
    "docs/FINAL-DEMO-READINESS.md",
    "docs/HACKATHON-PROJECT-FORM-DRAFT.md",
    "docs/REAL-CALL-SAFETY.md"
  ],
  "include": [
    ".env.example",
    ".github/workflows/ci.yml",
    ".gitignore",
    "CALL-E-installation-guide.md",
    "backend/**",
    "contribution/awesome-phone-call-agents/**",
    "data/seed_recipients.json",
    "docker-compose.dev.yml",
    "docs/DEMO-SCRIPT.md",
    "docs/FINAL-DEMO-CHECKLIST.md",
    "docs/FINAL-DEMO-READINESS.md",
    "docs/HACKATHON-PROJECT-FORM-DRAFT.md",
    "docs/PUBLIC-README.md",
    "docs/REAL-CALL-SAFETY.md",
    "frontend/**",
    "public-export/Makefile",
    "public-export-manifest.json",
    "scripts/final_readiness_check.py",
    "scripts/create_public_export.py",
    "scripts/public_export_check.py",
    "scripts/secrets_check.py"
  ],
  "exclude": [
    ".git/**",
    ".planning/**",
    "Makefile",
    "README.md",
    ".DS_Store",
    "**/.DS_Store",
    "data/*.db",
    "data/*.sqlite",
    "data/*.sqlite3",
    "deploy/**",
    "design/**",
    "docs/DEPLOYMENT-SECRETS-GUIDE.md",
    "docs/DEPLOYMENT.md",
    "docs/DOMAIN-STRATEGY.md",
    "docs/HETZNER-K3S-DEPLOYMENT-LOG-2026-08-05.md",
    "docs/HETZNER-K3S-RUNBOOK.md",
    "docs/HACKATHON-PUBLIC-SUBMISSION-STRATEGY.md",
    "docs/HEALTH-SUPPORT-ANALYSIS.md",
    "docs/INTERFACE-RESTRUCTURE-RESEARCH.md",
    "docs/MARKETING-MESSAGING.md",
    "docs/PRODUCTION-ARCHITECTURE-NOTES.md",
    "docs/PUBLIC-HACKATHON-EXPORT.md",
    "docs/VOICE-ASSISTANT-CALLBACK.md",
    "Health-monitoring/**",
    "logo/**"
  ],
  "forbidden_public_fragments": [
    "HETZNER_PUBLIC_IP",
    "api-origin.care.raixon.co.uk",
    "dockerhub-secret"
  ],
  "public_repo_policy": {
    "call_provider": "CALL-E only",
    "keep": [
      "runnable frontend and backend",
      "real CALL-E execution code path with live calls disabled by default",
      "dry-run preflight and exact approval gates",
      "fictional demo recipients and masked phone numbers",
      "backend and frontend tests",
      "public README, demo script, safety notes, final checklist, and contribution bundle"
    ],
    "remove": [
      "alternate call-provider, agent, or LLM adapter notes",
      "private deployment scripts and runbooks",
      "production domain and infrastructure strategy",
      "future voice assistant integration notes",
      "raw health research and marketing planning documents",
      "real participant data, tokens, secrets, and consent records"
    ]
  },
  "manual_submission_placeholders": [
    "<add sanitized public repository URL>",
    "<add PR URL after opening the pull request>",
    "<YouTube or Vimeo demo video URL>"
  ],
  "forbidden_public_readme_references": [
    "docs/DEPLOYMENT.md",
    "docs/DEPLOYMENT-SECRETS-GUIDE.md",
    "docs/DOMAIN-STRATEGY.md",
    "docs/HETZNER-K3S-DEPLOYMENT-LOG-2026-08-05.md",
    "docs/HETZNER-K3S-RUNBOOK.md",
    "docs/PRODUCTION-ARCHITECTURE-NOTES.md",
    ".planning/"
  ],
  "forbidden_public_doc_references": [
    "docs/DEPLOYMENT.md",
    "docs/DEPLOYMENT-SECRETS-GUIDE.md",
    "docs/DOMAIN-STRATEGY.md",
    "docs/HETZNER-K3S-DEPLOYMENT-LOG-2026-08-05.md",
    "docs/HETZNER-K3S-RUNBOOK.md",
    "docs/HACKATHON-PUBLIC-SUBMISSION-STRATEGY.md",
    "docs/HEALTH-SUPPORT-ANALYSIS.md",
    "docs/INTERFACE-RESTRUCTURE-RESEARCH.md",
    "docs/MARKETING-MESSAGING.md",
    "docs/PRODUCTION-ARCHITECTURE-NOTES.md",
    "docs/PUBLIC-HACKATHON-EXPORT.md",
    "docs/VOICE-ASSISTANT-CALLBACK.md",
    "Health-monitoring/",
    "deploy/",
    "design/",
    ".planning/"
  ],
  "forbidden_contribution_fragments": [
    "apps/typescript/carecall",
    "apps/typescript/care-call-ai",
    "# CareCall",
    "Adds CareCall"
  ],
  "required_contribution_fragments": {
    "contribution/awesome-phone-call-agents/APP-README.md": [
      "apps/web/care-call-ai/",
      "Contribution Area",
      "Side Effects",
      "Cancellation And Stop Conditions",
      "Credential Handling",
      "Dry Run And Preview Behaviour",
      "fictional recipients and masked phone numbers"
    ],
    "contribution/awesome-phone-call-agents/README-entry.md": [
      "Care Call AI",
      "apps/web/care-call-ai/",
      "dry-run preflight"
    ],
    "contribution/awesome-phone-call-agents/PR-DESCRIPTION.md": [
      "Care Call AI",
      "Suggested contribution area: `Apps`",
      "apps/web/care-call-ai/",
      "make public-export-check"
    ],
    "contribution/awesome-phone-call-agents/SAFETY-CHECKLIST.md": [
      "setup, side effects, cancellation/stop conditions",
      "credential handling",
      "dry-run/preview behaviour",
      "fictional or masked"
    ]
  }
}
